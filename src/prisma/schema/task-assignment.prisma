model TaskAssignment {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      TaskStatus     @default(TODO)
  priority    TaskPriority   @default(MEDIUM)
  assigneeId  String
  assignee    User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User           @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  completedAt DateTime?
  progress    Int            @default(0) // 0 to 100
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    TaskComment[]

  @@index([assigneeId])
  @@index([creatorId])
  @@index([status])
  @@index([priority])
  @@map("task_assignments")
}

model TaskComment {
  id        String         @id @default(cuid())
  taskId    String
  task      TaskAssignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
