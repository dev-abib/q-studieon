model User {
  id                     String              @id @default(cuid())
  name                   String?
  email                  String?             @unique
  password               String?
  profilePictureURL      String?
  profilePicturePublicId String?
  isPaid                 Boolean?            @default(false)
  isGuest                Boolean?
  isOtpVerified          Boolean?            @default(false)
  otp                    String?
  otpAttempts            Int?                @default(0)
  otpExpires             DateTime?
  refreshToken           String?
  resetToken             String?
  guestExpiresAt         DateTime?
  authProvider           AuthProvider?       @default(local)
  billingCycle           bilingCycle?        @default(monthly)
  status                 subscriptionStatus? @default(free)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  currentPeriodEnd       Int?
  role                   role                @default(user)
  userRole               userRole?           @map("user_role")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  termsAndConditions     Boolean             @default(false)
  blockedUntil           DateTime?
  guestIp                String?
  guestDeviceId          String?
  isResetRequest         Boolean?            @default(false)
  isOwner                Boolean             @default(false)
  canDeleteQueries       Boolean?            @default(false)
  canViewUserDetails     Boolean?            @default(false)
  canChangePassword      Boolean?            @default(false)
  canManageFaqs          Boolean?            @default(false)
  canManagePages         Boolean?            @default(false)
  canManageTasks         Boolean?            @default(false)
  canManagePayments      Boolean?            @default(false)
  canManageReports       Boolean?            @default(false)
  blockReason            String?
  isDeleted              Boolean             @default(false)
  deletedAt              DateTime?
  purgeAt                DateTime?
  deleteReason           String?
  deletedBy              String?
  lastLoginAt            DateTime?
  lastActiveIp           String?
  loginCount             Int?                @default(0)
  totalSessionMinutes    Int?                @default(0)
  adminGrantedAccess     Boolean?            @default(false)
  adminGrantedReason     String?
  adminGrantedBy         String?
  adminGrantedAt         DateTime?
  collections            Collection[]
  payments               Payment[]
  reports                Report[]
  sharedReports          SharedReport[]
  subscriptionEvents     SubscriptionEvent[]
  contactQueries         ContactQuery[]
  sessions               UserSession[]
  flags                  UserFlag[]          @relation("FlaggedUser")
  createdFlags           UserFlag[]          @relation("FlagCreator")
  auditLogs              StaffAuditLog[]
  internalNotes          InternalStaffNote[]
  // Chat relations
  createdGroups          ChatGroup[]         @relation("GroupCreator")
  groupMemberships       ChatGroupMember[]   @relation("GroupMember")
  sentMessages           ChatMessage[]       @relation("MessageSender")
  chatMentions           ChatMention[]       @relation("MentionedUser")
  chatReads              ChatRead[]          @relation("ChatReadUser")
  // Task relations
  assignedTasks          TaskAssignment[]    @relation("TaskAssignee")
  createdTasks           TaskAssignment[]    @relation("TaskCreator")
  taskComments           TaskComment[]       @relation("TaskCommentAuthor")
  // Web Push subscriptions
  pushSubscriptions      PushSubscription[]   @relation("PushSubscriptions")

  @@index([createdAt])
  @@index([isGuest])
  @@index([status])
  @@index([isPaid])
  @@index([isDeleted])
  @@index([purgeAt])
  @@index([lastLoginAt])
  @@index([lastActiveIp])
  @@map("users")
}

model UserSession {
  id              String    @id @default(cuid())
  userId          String
  ipAddress       String?
  userAgent       String?
  device          String?
  browser         String?
  os              String?
  city            String?
  country         String?
  loginAt         DateTime  @default(now())
  lastActiveAt    DateTime  @default(now())
  durationSeconds Int       @default(0)
  isCurrent       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@index([ipAddress])
  @@map("user_sessions")
}

model UserFlag {
  id           String      @id @default(cuid())
  userId       String
  flaggedById  String
  action       FlagAction  @default(BLOCK)
  reason       String
  note         String?
  status       FlagStatus  @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         User        @relation("FlaggedUser", fields: [userId], references: [id], onDelete: Cascade)
  flaggedBy    User        @relation("FlagCreator", fields: [flaggedById], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flaggedById])
  @@index([status])
  @@map("user_flags")
}

enum FlagAction {
  BLOCK
  DELETE
}

enum FlagStatus {
  PENDING
  APPROVED
  REJECTED
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  role      role
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("invitations")
}

enum AuthProvider {
  local
  google
  apple
  guest
}

enum subscriptionStatus {
  free
  trialing
  active
  past_due
  cancelled
  incomplete
}

enum bilingCycle {
  monthly
  yearly
}

enum role {
  user
  admin
  super_admin
  customer_support
  content_manager
  finance
}

enum userRole {
  buyer
  seller
  renter
  real_estate_agent
  brokerage
  practitioner
  home_explorer
  homeowner
  investor
  interior_designer
  architect
}
