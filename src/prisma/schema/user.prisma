model User {
  id                     String              @id @default(cuid())
  name                   String?
  email                  String?             @unique
  password               String?
  profilePictureURL      String?
  profilePicturePublicId String?
  isPaid                 Boolean?            @default(false)
  isGuest                Boolean?
  isOtpVerified          Boolean?            @default(false)
  otp                    String?
  otpAttempts            Int?                @default(0)
  otpExpires             DateTime?
  refreshToken           String?
  resetToken             String?
  guestExpiresAt         DateTime?
  authProvider           AuthProvider?       @default(local)
  billingCycle           bilingCycle?        @default(monthly)
  status                 subscriptionStatus? @default(free)
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  currentPeriodEnd       Int?
  role                   role                @default(user)
  userRole               userRole?           @map("user_role")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  termsAndConditions     Boolean             @default(false)
  blockedUntil           DateTime?
  guestIp                String?
  guestDeviceId          String?
  isResetRequest         Boolean?            @default(false)
  isOwner                Boolean             @default(false)
  canDeleteQueries       Boolean?            @default(false)
  collections            Collection[]
  payments               Payment[]
  reports                Report[]
  sharedReports          SharedReport[]
  subscriptionEvents     SubscriptionEvent[]
  contactQueries         ContactQuery[]

  @@index([createdAt])
  @@index([isGuest])
  @@index([status])
  @@index([isPaid])
  @@map("users")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  role      role
  token     String   @unique
  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("invitations")
}

enum AuthProvider {
  local
  google
  apple
  guest
}

enum subscriptionStatus {
  free
  trialing
  active
  past_due
  cancelled
  incomplete
}

enum bilingCycle {
  monthly
  yearly
}

enum role {
  user
  admin
  super_admin
  customer_support
  content_manager
  finance
}

enum userRole {
  buyer
  seller
  renter
  real_estate_agent
  brokerage
  practitioner
  home_explorer
  homeowner
  investor
  interior_designer
  architect
}
